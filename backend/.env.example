# Copy to backend/.env for running the backend outside docker.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
# Required when DJANGO_DEBUG is off (preview/production). The admin is served at /api/<DJANGO_ADMIN_PATH>/.
DJANGO_ADMIN_PATH=admin
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://dotcraft:dotcraft@localhost:5432/dotcraft
FRONTEND_URL=http://localhost:5173
# Mailpit (docker compose) catches e-mails locally; set BREVO_API_KEY in deployed envs instead.
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Dotcraft <no-reply@dotcraft.local>
# BREVO_API_KEY=
# Private Vercel Blob store for logos; the filesystem is used when unset.
# BLOB_READ_WRITE_TOKEN=
